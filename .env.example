ALLOWED_ORIGINS=https://your-frontend.example
API_KEYS=replace-with-a-long-random-key
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
INSTAGRAM_REQUEST_TIMEOUT=30

# Use one proxy for all Instagram traffic:
INSTAGRAM_PROXY=

# Or rotate through a comma-separated proxy pool:
INSTAGRAM_PROXIES=

# Optional per-protocol overrides:
INSTAGRAM_HTTP_PROXY=
INSTAGRAM_HTTPS_PROXY=

# Configure which reverse proxies Uvicorn trusts:
FORWARDED_ALLOW_IPS=*
